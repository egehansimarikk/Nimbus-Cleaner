        public static void Detect()
        {
            try
            {
                var two = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName.ToLowerInvariant();
                if (two == "nb" || two == "nn") two = "no";
                Code = Array.IndexOf(Codes, two) >= 0 ? two : "en";
            }
            catch { Code = "en"; }
        }

        static void Add(string code, Dictionary<string, string> d) => Map[code] = d;

        public static string G(string key)
        {
            Dictionary<string, string> d;
            if (Map.TryGetValue(Code, out d) && d.TryGetValue(key, out var s)) return s;
            if (Map["en"].TryGetValue(key, out s)) return s;
            return key;
        }

        static Dictionary<string, string> D(params string[] kv)
        {
            var d = new Dictionary<string, string>(StringComparer.Ordinal);
            for (int i = 0; i + 1 < kv.Length; i += 2) d[kv[i]] = kv[i + 1];
            return d;
        }

