        public static string DiskLine()
        {
            var parts = new List<string>();
            foreach (var d in DriveInfo.GetDrives())
            {
                try
                {
                    if (!d.IsReady || d.DriveType != DriveType.Fixed) continue;
                    parts.Add(string.Format(S.G("disk.free"), d.Name.TrimEnd('\\'), FormatSize(d.AvailableFreeSpace)));
                }
                catch { }
            }
            return parts.Count == 0 ? S.G("disk.none") : string.Join("   ", parts);
        }

        public static string RamLine()
        {
            try
            {
                var used = Process.GetProcesses().Sum(p =>
                {
                    try { return p.WorkingSet64; } catch { return 0L; }
                });
                return string.Format(S.G("ram.line"), FormatSize(used));
            }
            catch { return S.G("ram.none"); }
        }

        public static List<string> TopProcesses(int take = 8)
        {
            try
            {
                return Process.GetProcesses()
                    .Select(p =>
                    {
                        long ws = 0;
                        string n = "";
                        try { ws = p.WorkingSet64; n = p.ProcessName; } catch { }
                        return new { n, ws };
                    })
                    .Where(x => !string.IsNullOrEmpty(x.n))
                    .OrderByDescending(x => x.ws)
                    .Take(take)
                    .Select(x => $"{x.n}   {FormatSize(x.ws)}")
                    .ToList();
            }
            catch
            {
                return new List<string> { S.G("proc.none") };
            }
        }

        public static List<string> IpLines()
        {
            var lines = new List<string>();
            try
            {
                foreach (var nic in NetworkInterface.GetAllNetworkInterfaces())
                {
                    if (nic.OperationalStatus != OperationalStatus.Up) continue;
                    if (nic.NetworkInterfaceType == NetworkInterfaceType.Loopback) continue;

                    var ip = nic.GetIPProperties();
                    foreach (var a in ip.UnicastAddresses)
                    {
                        if (a.Address.AddressFamily == System.Net.Sockets.AddressFamily.InterNetwork)
                            lines.Add($"{nic.Name}  {a.Address}");
                    }
                }
            }
            catch { lines.Add(S.G("net.none")); }

            if (lines.Count == 0) lines.Add(S.G("net.noip"));
            return lines;
        }

        public static string Capture(string file, string args, int timeoutMs = 15000)
        {
            try
            {
                var psi = new ProcessStartInfo(file, args)
                {
                    CreateNoWindow = true,
                    UseShellExecute = false,
                    RedirectStandardOutput = true,
                    RedirectStandardError = true,
                    StandardOutputEncoding = Encoding.Default
                };

                using (var p = Process.Start(psi))
                {
                    if (p == null) return string.Empty;
                    var o = p.StandardOutput.ReadToEnd();
                    p.WaitForExit(timeoutMs);
                    return o;
                }
            }
            catch { return string.Empty; }
        }

