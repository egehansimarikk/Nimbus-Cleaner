        private async Task CheckForUpdatesAsync()
        {
            UpdateRelease release;
            try
            {
                release = await UpdateChecker.CheckForUpdateAsync(Application.ProductVersion);
            }
            catch
            {
                return;
            }

            if (release == null || IsDisposed) return;

            var answer = MessageBox.Show(this,
                $"A new version (v{release.VersionText}) is available. Would you like to update now?",
                "Update available", MessageBoxButtons.YesNo, MessageBoxIcon.Information);
            if (answer != DialogResult.Yes) return;

            try
            {
                var installerPath = await UpdateChecker.DownloadInstallerAsync(release);
                if (IsDisposed)
                {
                    try { File.Delete(installerPath); } catch { }
                    return;
                }

                Process.Start(new ProcessStartInfo(installerPath) { UseShellExecute = true });
                Close();
            }
            catch (Exception ex)
            {
                if (!IsDisposed)
                    MessageBox.Show(this, "The update could not be downloaded or started.\n\n" + ex.Message,
                        "Update failed", MessageBoxButtons.OK, MessageBoxIcon.Error);
            }
        }

