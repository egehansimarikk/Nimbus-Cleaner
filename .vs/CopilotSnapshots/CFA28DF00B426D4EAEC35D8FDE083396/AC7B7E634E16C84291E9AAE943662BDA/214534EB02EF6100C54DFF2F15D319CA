        private long CleanId(string id, CancellationToken ct)
        {
            CleanResult R(IEnumerable<string> p) => CleanEngine.CleanMany(p, ct);
            CleanResult D(string p) => CleanEngine.CleanTree(p, ct);

            switch (id)
            {
                case "temp": return R(CleanEngine.UserTemps()).Freed;
                case "wintemp": return NeedAdmin("Windows TEMP") ? D(Paths.TempWin).Freed : 0;
                case "recycle": CleanEngine.EmptyRecycle(); return 0;
                case "dns": CleanEngine.FlushDns(); return 0;
                case "thumbs": return CleanEngine.CleanThumbs();
                case "prefetch": return NeedAdmin("Prefetch") ? D(Paths.Prefetch).Freed : 0;
                case "recent": return D(Paths.Recent).Freed;
                case "browser": return R(CleanEngine.BrowserCaches()).Freed;
                case "dumps": return D(Paths.Dumps).Freed;
                case "inet": return D(Paths.INet).Freed;
                case "wer": return R(CleanEngine.WerPaths()).Freed;
                case "font": return D(Paths.Font).Freed;
                case "dx": return D(Paths.D3D).Freed;
                case "gpu": return R(CleanEngine.GpuCaches()).Freed;
                case "discord": return R(CleanEngine.DiscordCaches()).Freed;
                case "steam": return R(CleanEngine.SteamCaches()).Freed;
                case "teams": return R(CleanEngine.TeamsCaches()).Freed;
                case "office": return R(CleanEngine.OfficeCaches()).Freed;
                case "spotify": return R(CleanEngine.SpotifyCaches()).Freed;
                case "roblox": return R(CleanEngine.RobloxCaches()).Freed;
                case "vscode": return R(CleanEngine.VsCodeCaches()).Freed;
                case "webview": return R(CleanEngine.WebViewCaches()).Freed;
                case "java": return R(CleanEngine.JavaCaches()).Freed;
                case "adobe": return R(CleanEngine.AdobeCaches()).Freed;
                case "epic": return R(CleanEngine.EpicCaches()).Freed;
                case "logs": return NeedAdmin("logs") ? R(CleanEngine.WinLogs()).Freed : 0;
                case "notify": return R(CleanEngine.NotifyPaths()).Freed;
                case "zoom": return R(CleanEngine.ZoomCaches()).Freed;
                case "telegram": return R(CleanEngine.TelegramCaches()).Freed;
                case "xbox": return R(CleanEngine.XboxCaches()).Freed;
                case "photos": return R(CleanEngine.PhotosCaches()).Freed;
                case "npm": return R(CleanEngine.DevCaches()).Freed;
                case "onedrive": return R(CleanEngine.OneDriveLogs()).Freed;
                case "do": return NeedAdmin("DO") ? D(Paths.DO).Freed : 0;
                case "update": return NeedAdmin("Update") ? D(Paths.Update).Freed : 0;
                case "minidump": return NeedAdmin("Minidump") ? D(Paths.Mini).Freed : 0;
                case "oldwin": return Directory.Exists(Paths.OldWin) && NeedAdmin("Windows.old") ? D(Paths.OldWin).Freed : 0;
                default: return 0;
            }
