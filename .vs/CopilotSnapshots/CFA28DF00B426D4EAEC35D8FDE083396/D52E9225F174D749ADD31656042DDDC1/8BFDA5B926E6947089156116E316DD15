using System;
using System.Collections.Generic;
using System.IO;
using System.Linq;
using System.Net.Http;
using System.Threading.Tasks;
using System.Web.Script.Serialization;

namespace WinCleaner
{
    internal sealed class UpdateRelease
    {
        public Version Version { get; set; }
        public string VersionText { get; set; }
        public string InstallerUrl { get; set; }
    }

    internal static class UpdateChecker
    {
        private const string LatestReleaseUrl = "https://api.github.com/repos/egehansimarikk/Nimbus-Cleaner/releases/latest";
        private static readonly HttpClient Client = CreateClient();

        private static HttpClient CreateClient()
        {
            var client = new HttpClient();
            client.DefaultRequestHeaders.UserAgent.ParseAdd("NimbusCleanerApp");
            return client;
        }

        public static async Task<UpdateRelease> CheckForUpdateAsync(string currentProductVersion)
        {
            var json = await Client.GetStringAsync(LatestReleaseUrl).ConfigureAwait(false);
            var release = new JavaScriptSerializer().Deserialize<Dictionary<string, object>>(json);
            object tagValue;
            if (release == null || !release.TryGetValue("tag_name", out tagValue))
                throw new InvalidDataException("The latest GitHub release has no version tag.");

            var tagName = tagValue as string;
            Version latestVersion;
            Version currentVersion;
            if (string.IsNullOrWhiteSpace(tagName) ||
                !Version.TryParse(tagName.TrimStart('v', 'V'), out latestVersion) ||
                !Version.TryParse(currentProductVersion, out currentVersion) ||
                latestVersion <= currentVersion)
                return null;

            var installerUrl = FindInstallerUrl(release);
            return new UpdateRelease
            {
                Version = latestVersion,
                VersionText = latestVersion.ToString(),
                InstallerUrl = installerUrl
            };
        }

        public static async Task<string> DownloadInstallerAsync(UpdateRelease release)
        {
            Uri downloadUri;
            if (release == null || !Uri.TryCreate(release.InstallerUrl, UriKind.Absolute, out downloadUri) ||
                downloadUri.Scheme != Uri.UriSchemeHttps)
                throw new InvalidDataException("The latest release does not contain a valid HTTPS setup executable.");

            var filePath = Path.Combine(Path.GetTempPath(), "NimbusCleanerUpdate_" + Guid.NewGuid().ToString("N") + ".exe");
            try
            {
                using (var response = await Client.GetAsync(downloadUri, HttpCompletionOption.ResponseHeadersRead).ConfigureAwait(false))
                {
                    response.EnsureSuccessStatusCode();
                    using (var input = await response.Content.ReadAsStreamAsync().ConfigureAwait(false))
                    using (var output = new FileStream(filePath, FileMode.CreateNew, FileAccess.Write, FileShare.None, 81920, true))
                        await input.CopyToAsync(output).ConfigureAwait(false);
                }

                return filePath;
            }
            catch
            {
                try { if (File.Exists(filePath)) File.Delete(filePath); } catch { }
                throw;
            }
        }

        private static string FindInstallerUrl(Dictionary<string, object> release)
        {
            object assetsValue;
            var assets = release.TryGetValue("assets", out assetsValue) ? assetsValue as object[] : null;
            if (assets == null) return null;

            return assets
                .OfType<Dictionary<string, object>>()
                .Where(asset =>
                    asset.TryGetValue("name", out var nameValue) &&
                    nameValue is string name &&
                    name.EndsWith(".exe", StringComparison.OrdinalIgnoreCase) &&
                    asset.TryGetValue("browser_download_url", out var urlValue) &&
                    urlValue is string url &&
                    url.StartsWith("https://", StringComparison.OrdinalIgnoreCase) &&
                    Uri.TryCreate(url, UriKind.Absolute, out var downloadUri) &&
                    downloadUri.Scheme == Uri.UriSchemeHttps)
                .Select(asset => (string)asset["browser_download_url"])
                .FirstOrDefault();
        }
    }
}
